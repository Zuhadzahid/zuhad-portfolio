# The site's public URL (set to your Vercel/custom domain in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Everything below is OPTIONAL — uncomment only if you use the feature.
# Keeping them commented out stops Vercel from auto-importing them.
# ------------------------------------------------------------------

# Set by Vercel automatically on every deployment (footer build info).
# VERCEL_ENV=
# VERCEL_GIT_COMMIT_SHA=

# shadcn registry namespace (only if you publish your own registry)
# NEXT_PUBLIC_REGISTRY_NAMESPACE=@acme
# NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=https://acme.com/r/{name}.json

# GitHub contributions graph (token only for higher rate limits)
# https://github.com/settings/tokens
# GITHUB_API_TOKEN=
# GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de

# DMCA protection badge — https://www.dmca.com/ProtectionPro.aspx
# NEXT_PUBLIC_DMCA_URL=https://www.dmca.com

# OpenPanel analytics — https://openpanel.dev
# NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
# OPENPANEL_PROJECT_ID=
# OPENPANEL_CLIENT_ID=
# OPENPANEL_CLIENT_SECRET=

# Google Tag Manager — https://tagmanager.google.com
# NEXT_PUBLIC_GTM_ID=

# Google AdSense
# ADS_TXT=
# NEXT_PUBLIC_ADSENSE_CLIENT=

# Cloudflare R2 (used by `pnpm capture:sync` to publish screenshots)
# R2_S3_API=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
